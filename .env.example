# Copy to .env.local and fill in. Never commit .env.local.

# Uploadcare (dashboard > API keys). The public key is exposed to the browser.
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=

# Cloudinary (console > API keys). Server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Magic Hour (settings > developer). The webhook secret is issued when the
# production webhook URL (https://<app>/api/webhook) is registered in the dashboard.
MAGIC_HOUR_API_KEY=
MAGIC_HOUR_WEBHOOK_SECRET=

# MongoDB Atlas connection string (database user with readWrite on this database only).
MONGODB_URI=
MONGODB_DB_NAME=v2v

# Signs the anonymous user cookie. Generate with: openssl rand -base64 32
SESSION_COOKIE_SECRET=

# Application settings
MAX_UPLOAD_BYTES=104857600
ALLOWED_VIDEO_FORMATS=video/mp4,video/quicktime,video/webm
MAX_CLIP_SECONDS=30
JOB_GRACE_MINUTES=120
