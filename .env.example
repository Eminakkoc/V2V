# Copy to .env.local and fill in. Never commit .env.local.
# public = not a secret (NEXT_PUBLIC_ values are also sent to the browser); plain in Vercel.
# secret = server only; marked Sensitive in Vercel.

# --- Uploadcare: dashboard > your project > API keys (enable signed uploads on the project)
# public
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=
# secret
UPLOADCARE_SECRET_KEY=

# --- Cloudinary: console > Settings > API Keys
# public (appears in every delivery URL)
CLOUDINARY_CLOUD_NAME=
# secret
CLOUDINARY_API_KEY=
# secret
CLOUDINARY_API_SECRET=

# --- Magic Hour: dashboard > Developer
# secret
MAGIC_HOUR_API_KEY=
# secret. Issued when the production webhook URL (https://<app>.vercel.app/api/webhook)
# is registered for video.started, video.completed and video.errored.
MAGIC_HOUR_WEBHOOK_SECRET=

# --- MongoDB Atlas: cluster > Connect > Drivers (user with readWrite on this database only)
# secret
MONGODB_URI=
# public
MONGODB_DB_NAME=v2v

# --- Generated locally, no dashboard
# secret. Signs the anonymous user cookie. Generate with: openssl rand -base64 32
SESSION_COOKIE_SECRET=

# --- Application settings, all public
# 100 MB, Cloudinary's plain upload limit
MAX_UPLOAD_BYTES=104857600
# MIME types the validation layer accepts
ALLOWED_VIDEO_FORMATS=video/mp4,video/quicktime,video/webm
# Longest clip sent to Magic Hour, keeps credit spend predictable
MAX_CLIP_SECONDS=30
# How long past a job's deadline the app keeps checking before marking it abandoned
JOB_GRACE_MINUTES=120

# Job deadline: base + per-clip-second, capped. Provisional values — DEP-003
# measures real Magic Hour render times; correcting these is a config change.
JOB_DEADLINE_BASE_MINUTES=5
JOB_DEADLINE_SECONDS_PER_CLIP_SECOND=30
JOB_DEADLINE_MAX_MINUTES=30

# --- Testing only, never set in Vercel
# fake = in-memory Uploadcare and Cloudinary adapters for end-to-end tests. Default: real
# PROVIDER_MODE=real
